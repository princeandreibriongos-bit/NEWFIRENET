# FireNet — Vercel / hosting Environment Variables
# Project → Settings → Environment Variables → add these for Production
# (and Preview if you test there). Redeploy after saving.

# --- Cloudflare R2 (cloud storage) ---
FIRENET_R2_ENABLED=true
FIRENET_R2_ACCOUNT_ID=your_cloudflare_account_id
FIRENET_R2_ACCESS_KEY_ID=your_r2_access_key_id
FIRENET_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
FIRENET_R2_BUCKET=firenet-bucket
FIRENET_R2_BASE_PREFIX=firenet

# --- SMTP (forgot-password OTP + security emails) ---
FIRENET_MAIL_SMTP_HOST=smtp.gmail.com
FIRENET_MAIL_SMTP_PORT=587
FIRENET_MAIL_SMTP_USERNAME=yourgmail@gmail.com
FIRENET_MAIL_SMTP_PASSWORD=your_gmail_app_password_no_spaces
FIRENET_MAIL_SMTP_ENCRYPTION=tls
FIRENET_MAIL_FROM_EMAIL=yourgmail@gmail.com
FIRENET_MAIL_FROM_NAME=FireNet Security

# Notes:
# - Do not commit real secrets to Git.
# - Local XAMPP can keep using config/r2.local.php + config/config.php mail block.
# - When an env var is set, it overrides the matching config file value.
